# ==============================================================================
# DAWAAK (دواك) ONLINE PHARMACY — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local for local execution.
# DO NOT COMMIT .env.local OR ANY ACTUAL CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# Application Branding & Localization
NEXT_PUBLIC_APP_NAME="دواك - صيدلية إلكترونية"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_LOCALE="ar"
NEXT_PUBLIC_SUPPORTED_LOCALES="ar,en"

# Data Source Provider ('mock' | 'postgres' | 'supabase')
# Defaults to 'mock' for standalone zero-dependency local development and automated testing
DATA_SOURCE="mock"
NEXT_PUBLIC_DATA_SOURCE="mock"

# Legacy Flag (Preserved for backward compatibility)
NEXT_PUBLIC_ENABLE_MOCK_DATA="true"

# Supabase / PostgreSQL Configuration (Optional for mock mode; Required for postgres mode)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-public-anon-key-here"
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-public-anon-key-here"

# Server-Side Only Database Secrets (NEVER expose to browser / client bundles)
DATABASE_URL="postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-never-expose-to-browser"

# Healthcare Data Storage (Private Prescriptions Bucket)
SUPABASE_PRESCRIPTIONS_BUCKET="patient-prescriptions-private"
PRESCRIPTION_SIGNED_URL_EXPIRY_SECONDS=900

# Session & Security Settings
SESSION_SECRET="generate-a-secure-32-byte-hex-string-for-session-encryption"
NEXTAUTH_SECRET="generate-a-secure-32-byte-hex-string-for-auth"
